{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Xacpant — T-Embed Plus",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/setup_build.py",
        "--build"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3.12",
          "tools/setup_build.py",
          "--build"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}

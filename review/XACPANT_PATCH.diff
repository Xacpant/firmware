+    tft.printf("%s\n%s\n", msg, stackTrace);
+    Serial.printf("%s\n%s\n", msg, stackTrace);
+    Serial.flush();
+
+    delay(500);
+    while (!check(AnyKeyPress)) delay(50);
+}

-        Serial.printf("Could not open file: %s\n", filepath.c_str());
-        return NULL;
-    }
-
-    size_t fileLen = file.size();
-    char *buf = (char *)(psramFound() ? ps_malloc(fileLen + 1) : malloc(fileLen + 1));

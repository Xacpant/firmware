--- /dev/null
+++ b/.github/workflows/build_tembed_plus.yml
@@ -0,0 +1,23 @@
+name: Build Xacpant T-Embed CC1101 Plus
+on:
+  workflow_dispatch:
+  push:
+    branches: [xacpant-tembed-plus]
+  pull_request:
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - run: python -m pip install platformio==6.2.0
+      - run: python -m unittest discover -s tests -p 'test_*.py' -v
+      - run: pio run -e lilygo-t-embed-cc1101-plus
+      - uses: actions/upload-artifact@v4
+        with:
+          name: Xacpant-T-Embed-CC1101-Plus
+          path: |
+            .pio/build/lilygo-t-embed-cc1101-plus/firmware.bin
+            Xacpant-*.bin

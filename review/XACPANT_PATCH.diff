-    }
-
-    size_t bytesRead = 0;
-    while (bytesRead < fileLen && file.available()) {
-        size_t toRead = fileLen - bytesRead;
-        if (toRead > 512) { toRead = 512; }
-        file.read((uint8_t *)(buf + bytesRead), toRead);
-        bytesRead += toRead;
-    }
-    buf[bytesRead] = '\0';
-    file.close();
-
-    return buf;
-}

+bool JS_IsTypedArray(JSContext *ctx, JSValue val) {
+    int classId = JS_GetClassID(ctx, val);
+    return (classId >= JS_CLASS_ARRAY_BUFFER && classId <= JS_CLASS_UINT32_ARRAY);
+}

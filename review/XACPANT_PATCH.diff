+}
+
+/***************************************************************************************
+** Function name: ToggleSDCard
+** Description:   Turn Off or On the SDCard, return sdcardMounted state
+***************************************************************************************/
+bool ToggleSDCard() {
+    if (sdcardMounted == true) {
+        closeSdCard();
+        sdcardMounted = false;
+        return false;
+    } else {
+        sdcardMounted = setupSdCard();
+        return sdcardMounted;
+    }
